# RecallOps Cortex backend — copy to backend/.env and fill in for LIVE mode.
# openFDA is public (always live). Everything else is OPTIONAL — without it the
# service runs in clearly-labelled fallback mode, so the demo never breaks.

# --- Gemini 3 via Vertex AI (preferred) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GEMINI_MODEL=gemini-3-pro          # confirm the exact id from the hackathon resources / Vertex console
USE_VERTEX=true

# --- OR Gemini via Google AI Studio API key (no GCP billing needed) ---
GOOGLE_API_KEY=

# --- BigQuery (operational warehouse) ---
BIGQUERY_DATASET=recallops_cortex

# --- Fivetran (partner-track requirement) ---
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=

# --- Observability: OpenTelemetry → Arize Phoenix / Dynatrace ---
# Spans are ALWAYS captured in-process (see /llmops). Set this to ALSO export:
#   Arize Phoenix:  pip install arize-phoenix && phoenix serve
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:6006/v1/traces (Phoenix) or your Dynatrace OTLP URL

# --- Elastic (PLUGGABLE — recall + audit full-text search) ---
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# --- MongoDB (PLUGGABLE — agent memory + vector similar-recalls) ---
MONGODB_URI=
MONGODB_DB=recallops

# --- behaviour ---
USE_CACHED_FALLBACK=true
FRESHNESS_LIMIT_MIN=15
CORS_ORIGINS=*
